FROM python:3.12-slim
WORKDIR /app/server
COPY server/requirements-public.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY server/config/base.py server/config/public_settings.py server/config/public_wsgi.py server/config/__init__.py ./config/
COPY server/delivery ./delivery
COPY server/deploy/start.sh ./start.sh
COPY server/deploy/railway_runtime.py ./railway_runtime.py
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin survey
USER survey
EXPOSE 8443
ENV DJANGO_SETTINGS_MODULE=config.public_settings
CMD ["sh", "start.sh", "config.public_wsgi:application"]
