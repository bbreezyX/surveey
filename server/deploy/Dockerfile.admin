FROM node:24-alpine AS admin-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY admin ./admin
# The admin's map backdrop reuses the public map's pin/boundary styles, the
# emblem, and the boundary sources it simplifies at build time.
COPY src/shared ./src/shared
COPY src/public/map ./src/public/map
COPY src/public/state/list-model.ts ./src/public/state/list-model.ts
COPY assets/lambang-jambi.png ./assets/lambang-jambi.png
COPY layers/BatasKabupaten_1.js ./layers/BatasKabupaten_1.js
COPY data/dissolved.geojson ./data/dissolved.geojson
COPY tsconfig.json vite.admin.config.mts svelte.config.js ./
RUN npm run build:admin

FROM caddy:2.11.7-alpine AS proxy

FROM python:3.12-slim
WORKDIR /app/server
COPY server/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY server/config ./config
COPY server/survey ./survey
COPY server/delivery ./delivery
COPY server/templates ./templates
COPY server/manage.py ./manage.py
COPY server/deploy/start.sh ./start.sh
COPY server/deploy/railway_runtime.py server/deploy/gunicorn.railway.py server/deploy/Caddyfile.railway-admin ./
COPY --from=proxy /usr/bin/caddy /usr/local/bin/caddy
COPY --from=admin-build /app/dist/admin /app/dist/admin
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin survey
USER survey
EXPOSE 8443
CMD ["sh", "start.sh", "config.admin_wsgi:application"]
