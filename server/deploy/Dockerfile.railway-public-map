FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2.11.7-alpine
WORKDIR /srv
COPY server/deploy/Caddyfile.railway-public /etc/caddy/Caddyfile
RUN PUBLIC_DATA_HOST=survey-public-data.railway.internal PUBLIC_ADMIN_HOST=survey-admin.railway.internal caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
COPY server/deploy/start-railway-public.sh /usr/local/bin/start-railway-public.sh
RUN sed -i 's/\r$//' /usr/local/bin/start-railway-public.sh
# Cutover artifact: original evidence and the old static point database are deliberately absent.
COPY --from=build /app/dist/public/assets/ /srv/assets/
COPY --from=build /app/dist/public/index.html /app/dist/public/favicon.ico /app/dist/public/favicon.png /app/dist/public/apple-touch-icon.png /app/dist/public/manifest.json /srv/
COPY --from=build /app/dist/public/data/dissolved.geojson /app/dist/public/data/kabupaten.geojson /srv/data/
CMD ["sh", "/usr/local/bin/start-railway-public.sh"]
